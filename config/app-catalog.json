[
  {
    "id": "immich",
    "name": "Immich",
    "category": "Fotos & Videos",
    "tagline": "Selbstgehostete Google-Fotos-Alternative mit Handy-Sync & KI-Suche",
    "image": "ghcr.io/immich-app/immich-server:release",
    "defaultPort": 2283,
    "containerPort": 2283,
    "restartPolicy": "unless-stopped",
    "volumes": [
      { "label": "Mediathek / Foto-Ordner", "hostDefault": "/mnt/fotos", "containerPath": "/usr/src/app/upload" }
    ],
    "env": [
      { "key": "TZ", "value": "Europe/Berlin" }
    ],
    "note": "Hinweis: Immich benötigt zusätzlich PostgreSQL (pgvecto-rs) & Redis. Empfohlen für Einzel-Container-Tests oder via Compose-Stack."
  },
  {
    "id": "jellyfin",
    "name": "Jellyfin",
    "category": "Fotos & Videos",
    "tagline": "Freier Medienserver für Filme, Serien, Musik & Live-TV ohne Abo",
    "image": "lscr.io/linuxserver/jellyfin:latest",
    "defaultPort": 8096,
    "containerPort": 8096,
    "restartPolicy": "unless-stopped",
    "volumes": [
      { "label": "Konfiguration", "hostDefault": "/opt/stacks/jellyfin/config", "containerPath": "/config" },
      { "label": "Filme-Festplatte", "hostDefault": "/mnt/filme", "containerPath": "/data/movies" },
      { "label": "Serien-Festplatte", "hostDefault": "/mnt/serien", "containerPath": "/data/tvshows" }
    ],
    "env": [
      { "key": "PUID", "value": "1000" },
      { "key": "PGID", "value": "1000" },
      { "key": "TZ", "value": "Europe/Berlin" }
    ]
  },
  {
    "id": "plex",
    "name": "Plex Media Server",
    "category": "Fotos & Videos",
    "tagline": "Beliebter Medienserver für Filme, Serien & Musik auf allen Geräten",
    "image": "lscr.io/linuxserver/plex:latest",
    "defaultPort": 32400,
    "containerPort": 32400,
    "restartPolicy": "unless-stopped",
    "volumes": [
      { "label": "Konfiguration", "hostDefault": "/opt/stacks/plex/config", "containerPath": "/config" },
      { "label": "Filme & Videos", "hostDefault": "/mnt/filme", "containerPath": "/movies" },
      { "label": "Serien", "hostDefault": "/mnt/serien", "containerPath": "/tv" }
    ],
    "env": [
      { "key": "PUID", "value": "1000" },
      { "key": "PGID", "value": "1000" },
      { "key": "VERSION", "value": "docker" },
      { "key": "TZ", "value": "Europe/Berlin" }
    ]
  },
  {
    "id": "photoprism",
    "name": "PhotoPrism",
    "category": "Fotos & Videos",
    "tagline": "KI-gestützte Foto- & Video-Verwaltung für große RAW-Sammlungen",
    "image": "photoprism/photoprism:latest",
    "defaultPort": 2342,
    "containerPort": 2342,
    "restartPolicy": "unless-stopped",
    "volumes": [
      { "label": "Originale (Fotos)", "hostDefault": "/mnt/fotos", "containerPath": "/photoprism/originals" },
      { "label": "Datenbank & Cache", "hostDefault": "/opt/stacks/photoprism/storage", "containerPath": "/photoprism/storage" }
    ],
    "env": [
      { "key": "PHOTOPRISM_ADMIN_USER", "value": "admin" },
      { "key": "PHOTOPRISM_ADMIN_PASSWORD", "value": "homeserver" },
      { "key": "TZ", "value": "Europe/Berlin" }
    ]
  },
